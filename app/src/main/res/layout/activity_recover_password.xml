<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recover Password"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppings_semibold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="100dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/emailController"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:orientation="horizontal">
        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the OTP sent to "
            android:textSize="16sp"
            android:textColor="#7D7D7D"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="8dp" />
        <!-- User Email -->
        <TextView
            android:id="@+id/userEmail_RecoverPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user_email"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppings_semibold"
            android:layout_marginTop="8dp" />

    </LinearLayout>



    <!-- OTP Boxes -->
    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/emailController"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <EditText
            android:id="@+id/otpBox1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:textSize="18sp"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/otpBox2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:textSize="18sp"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="25dp" />

        <EditText
            android:id="@+id/otpBox3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:textSize="18sp"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="25dp" />

        <EditText
            android:id="@+id/otpBox4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:textSize="18sp"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="25dp" />

        <EditText
            android:id="@+id/otpBox5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:textSize="18sp"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="25dp"/>
    </LinearLayout>

    <!-- Reset Password Button -->
    <Button
        android:id="@+id/btnResetPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Reset Password"
        android:backgroundTint="#179F1E"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/resendCodeController"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnResetPassword"
        android:orientation="horizontal">
        <!-- Subtitle -->
        <TextView
            android:id="@+id/codeQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't get a code? "
            android:textSize="16sp"
            android:textColor="#7D7D7D"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="8dp" />
        <!-- User Email -->
        <TextView
            android:id="@+id/resendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend code"
            android:textSize="16sp"
            android:textColor="#179F1E"
            android:fontFamily="@font/poppings_semibold"
            android:layout_marginTop="8dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>