<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WelcomeScreenActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Farm Budget"
        android:textSize="24sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="#179F1E"
        android:layout_marginTop="100dp"
        android:id="@+id/txtFarmBudget"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Welcome to Farm Budget"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/black"
        android:layout_marginTop="181dp"
        android:id="@+id/txtWelcome"/>

    <TextView
        android:layout_width="240dp"
        android:layout_height="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/welcome_message"
        android:textSize="12sp"
        android:textAlignment="center"
        android:fontFamily="@font/poppins_regular"
        android:textColor="#7D7D7D"
        android:layout_marginTop="217dp"
        android:id="@+id/txtWelcomeMessage"/>
    
    <com.google.android.material.button.MaterialButton
        android:layout_width="335dp"
        android:layout_height="50dp"
        android:text="Login"
        android:textColor="#179F1E"
        android:fontFamily="@font/poppings_semibold"
        android:textSize="12sp"
        android:backgroundTint="#E5FFE6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cornerRadius="100dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="331dp"
        android:id="@+id/btnWelcomeLogin"/>

    <com.google.android.material.button.MaterialButton
        android:layout_width="335dp"
        android:layout_height="50dp"
        android:text="Create account"
        android:textColor="#FFFF"
        android:fontFamily="@font/poppings_semibold"
        android:textSize="12sp"
        android:id="@+id/btnWelcome_createAccount"
        android:backgroundTint="#179F1E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cornerRadius="100dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="386dp"/>

    <ImageView
        android:layout_width="335dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="569dp" />

    <TextView
        android:layout_width="34dp"
        android:layout_height="38dp"
        android:text="Or"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="550dp"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/black"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeGoogleLogin"
        android:layout_width="335dp"
        android:layout_height="50dp"
        android:text="Continue with Google"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_google_logo"
        app:iconGravity="textStart"
        app:iconTint="@null"
        android:fontFamily="@font/poppings_semibold"
        app:backgroundTint="#F7F7F7"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="625dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>